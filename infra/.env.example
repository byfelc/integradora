# Copia este archivo como .env (NO se versiona) y ajusta los valores locales.
# En GitHub estos valores viven como Secrets por ambiente (staging / production).

POSTGRES_DB=tdimp
POSTGRES_USER=tdimp
POSTGRES_PASSWORD=cambia-esto-localmente

# Backend
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tdimp
SPRING_DATASOURCE_USERNAME=tdimp
SPRING_DATASOURCE_PASSWORD=cambia-esto-localmente
TELEMETRY_API_KEY=dev-telemetry-key
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Videojuego (lo lee TelemetryConfig en Unity)
TELEMETRY_BASE_URL=http://localhost:8080
